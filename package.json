{
    "name": "spacefight",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "shared",
        "client",
        "server"
    ],
    "scripts": {
        "dev": "npm --workspace client run dev",
        "dev:server": "npm --workspace server run dev",
        "start": "node server/dist/index.js",
        "build": "npm --workspace shared run build && npm --workspace server run build && npm --workspace client run build",
        "preview": "npm --workspace client run preview",
        "lint": "eslint shared/src server/src client/src",
        "format": "prettier --write \"shared/src/**/*.ts\" \"server/src/**/*.ts\" \"client/src/**/*.ts\"",
        "format:check": "prettier --check \"shared/src/**/*.ts\" \"server/src/**/*.ts\" \"client/src/**/*.ts\"",
        "test": "vitest run",
        "test:shared": "vitest run shared/test",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "typecheck": "npm --workspace shared run build && npm --workspace server run typecheck && npm --workspace client run typecheck"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.1",
        "@types/node": "^26.6.10",
        "@types/ws": "^8.18.2",
        "@vitest/coverage-v8": "^5.1.2",
        "fast-check": "^4.11.0",
        "prettier": "^3.10.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.1.2"
    }
}
