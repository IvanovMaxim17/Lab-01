{
  "name": "spacefight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build",
    "preview": "npm --workspace client run preview",
    "lint": "npm --workspace client run lint",
    "test:shared": "node --test shared/test/*.test.js"
  }
}